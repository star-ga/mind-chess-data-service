// TB8 Storage - 8-man tablebase (selective)
// Returns disabled if not loaded

import std.os
import std.mem

pub const Tb8Record = packed struct {
    key: u64
    wdl: i8       // -2=loss, -1=cursed, 0=draw, 1=blessed, 2=win
    dtz: i16      // Distance to zeroing
    _pad: [5]u8
}

pub const Tb8Result = struct {
    wdl: i8
    dtz: i16
}

pub struct Tb8Store {
    data: []align(8) const u8
    fd: i32
    record_count: usize
}

pub fn Tb8Store.open(path: []const u8) !*Tb8Store {
    var store = try mem.heap_alloc(Tb8Store)
    errdefer mem.heap_free(store)

    var file_path_buf: [512]u8 = undefined
    let file_path = std.fmt.bufPrint(&file_path_buf, "{s}/tb8.bin", .{path}) catch return error.PathTooLong

    store.fd = try os.open(file_path, os.O_RDONLY, 0)
    errdefer os.close(store.fd)

    let stat = try os.fstat(store.fd)
    let size = stat.st_size

    store.data = try os.mmap(null, size, os.PROT_READ, os.MAP_PRIVATE, store.fd, 0)
    store.record_count = size / @sizeOf(Tb8Record)

    return store
}

pub fn Tb8Store.close(self: *Tb8Store) void {
    os.munmap(self.data)
    os.close(self.fd)
    mem.heap_free(self)
}

pub fn Tb8Store.count(self: *Tb8Store) usize {
    return self.record_count
}

pub fn Tb8Store.lookup(self: *Tb8Store, key: u64) ?Tb8Result {
    // Binary search (records must be sorted by key)
    let records = @ptrCast([*]const Tb8Record, self.data.ptr)[0..self.record_count]

    var lo: usize = 0
    var hi: usize = self.record_count

    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if records[mid].key < key {
            lo = mid + 1
        } else if records[mid].key > key {
            hi = mid
        } else {
            return Tb8Result{
                .wdl = records[mid].wdl,
                .dtz = records[mid].dtz,
            }
        }
    }

    return null
}
