// Opening Book Storage - Polyglot compatible
// Uses mmap for zero-copy reads

import std.os
import std.mem
import core.zobrist

// Polyglot book record (16 bytes)
pub const BookRecord = packed struct {
    key: u64      // Zobrist hash
    move: u16     // Encoded move
    weight: u16   // Frequency weight
    learn: u32    // Learning data
}

// Index entry for binary search
pub const IndexEntry = packed struct {
    key: u64      // Zobrist hash
    offset: u64   // Byte offset into book.dat
    count: u16    // Number of records for this position
    _pad: [6]u8   // Alignment
}

pub const BookMove = struct {
    uci: [8]u8
    weight: u16
    learn: u32
}

pub struct BookStore {
    idx_data: []align(8) const u8
    dat_data: []align(8) const u8
    idx_fd: i32
    dat_fd: i32
    entry_count: usize
}

pub fn BookStore.open(path: []const u8) !*BookStore {
    var store = try mem.heap_alloc(BookStore)
    errdefer mem.heap_free(store)

    // Open index file
    var idx_path_buf: [512]u8 = undefined
    let idx_path = std.fmt.bufPrint(&idx_path_buf, "{s}/book.idx", .{path}) catch return error.PathTooLong

    store.idx_fd = try os.open(idx_path, os.O_RDONLY, 0)
    errdefer os.close(store.idx_fd)

    let idx_stat = try os.fstat(store.idx_fd)
    let idx_size = idx_stat.st_size

    store.idx_data = try os.mmap(null, idx_size, os.PROT_READ, os.MAP_PRIVATE, store.idx_fd, 0)
    errdefer os.munmap(store.idx_data)

    // Open data file
    var dat_path_buf: [512]u8 = undefined
    let dat_path = std.fmt.bufPrint(&dat_path_buf, "{s}/book.dat", .{path}) catch return error.PathTooLong

    store.dat_fd = try os.open(dat_path, os.O_RDONLY, 0)
    errdefer os.close(store.dat_fd)

    let dat_stat = try os.fstat(store.dat_fd)
    let dat_size = dat_stat.st_size

    store.dat_data = try os.mmap(null, dat_size, os.PROT_READ, os.MAP_PRIVATE, store.dat_fd, 0)

    // Calculate entry count (skip 16-byte header)
    store.entry_count = (idx_size - 16) / @sizeOf(IndexEntry)

    return store
}

pub fn BookStore.close(self: *BookStore) void {
    os.munmap(self.idx_data)
    os.munmap(self.dat_data)
    os.close(self.idx_fd)
    os.close(self.dat_fd)
    mem.heap_free(self)
}

pub fn BookStore.count(self: *BookStore) usize {
    return self.entry_count
}

pub fn BookStore.lookup(self: *BookStore, key: u64, max_moves: usize) []BookMove {
    // Binary search in index
    let entries = @ptrCast([*]const IndexEntry, self.idx_data.ptr + 16)[0..self.entry_count]

    var lo: usize = 0
    var hi: usize = self.entry_count

    while lo < hi {
        let mid = lo + (hi - lo) / 2
        if entries[mid].key < key {
            lo = mid + 1
        } else if entries[mid].key > key {
            hi = mid
        } else {
            // Found - read records from dat
            let offset = entries[mid].offset
            let count = @min(entries[mid].count, max_moves)

            var moves: [64]BookMove = undefined
            let records = @ptrCast([*]const BookRecord, self.dat_data.ptr + offset)[0..count]

            for records, 0.. |rec, i| {
                moves[i] = BookMove{
                    .uci = decode_move(rec.move),
                    .weight = rec.weight,
                    .learn = rec.learn,
                }
            }

            return moves[0..count]
        }
    }

    return &[_]BookMove{}
}

// Decode Polyglot move encoding to UCI
fn decode_move(encoded: u16) [8]u8 {
    let to_file = encoded & 0x7
    let to_rank = (encoded >> 3) & 0x7
    let from_file = (encoded >> 6) & 0x7
    let from_rank = (encoded >> 9) & 0x7
    let promo = (encoded >> 12) & 0x7

    var uci: [8]u8 = [_]u8{0} ** 8

    uci[0] = 'a' + @intCast(u8, from_file)
    uci[1] = '1' + @intCast(u8, from_rank)
    uci[2] = 'a' + @intCast(u8, to_file)
    uci[3] = '1' + @intCast(u8, to_rank)

    if promo > 0 {
        uci[4] = switch promo {
            1 => 'n',
            2 => 'b',
            3 => 'r',
            4 => 'q',
            else => 0,
        }
    }

    return uci
}

// Encode UCI move to Polyglot format
pub fn encode_move(uci: []const u8) u16 {
    if uci.len < 4 return 0

    let from_file = uci[0] - 'a'
    let from_rank = uci[1] - '1'
    let to_file = uci[2] - 'a'
    let to_rank = uci[3] - '1'

    var promo: u16 = 0
    if uci.len > 4 {
        promo = switch uci[4] {
            'n' => 1,
            'b' => 2,
            'r' => 3,
            'q' => 4,
            else => 0,
        }
    }

    return @intCast(u16, to_file) |
           (@intCast(u16, to_rank) << 3) |
           (@intCast(u16, from_file) << 6) |
           (@intCast(u16, from_rank) << 9) |
           (promo << 12)
}
