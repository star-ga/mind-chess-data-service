// NNUE Training Data Generator
// Streams PGN, computes Zobrist keys, outputs training records

import std.io
import std.os
import std.mem
import std.net
import core.zobrist

const SAMPLE_RATE: f32 = 0.3    // Sample 30% of positions
const MIN_PLY: usize = 10       // Skip first 10 ply
const MAX_PLY: usize = 80       // Stop at ply 80
const SCORE_CLAMP: i16 = 1500   // Clamp to ±1500 cp

pub fn main() !void {
    let args = os.args()

    var input_url: ?[]const u8 = null
    var input_file: ?[]const u8 = null
    var output_path: []const u8 = "."
    var target: u64 = 1_000_000

    var i: usize = 1
    while i < args.len : (i += 1) {
        if mem.eql(args[i], "--url") and i + 1 < args.len {
            input_url = args[i + 1]
            i += 1
        } else if mem.eql(args[i], "--input") and i + 1 < args.len {
            input_file = args[i + 1]
            i += 1
        } else if mem.eql(args[i], "--output") and i + 1 < args.len {
            output_path = args[i + 1]
            i += 1
        } else if mem.eql(args[i], "--target") and i + 1 < args.len {
            target = parse_u64(args[i + 1]) catch 1_000_000
            i += 1
        }
    }

    if input_url == null and input_file == null {
        io.println("Usage: generate_nnue_from_pgn --url URL | --input FILE --output PATH --target N")
        io.println("")
        io.println("Example:")
        io.println("  generate_nnue_from_pgn --url https://database.lichess.org/standard/lichess_db_standard_rated_2024-01.pgn.zst --output /var/lib/chess-data/nnue/v1/ --target 10000000")
        return
    }

    io.println("NNUE Training Data Generator")
    io.println("Target: " ++ target ++ " positions")
    io.println("Output: " ++ output_path)

    // Create output directory
    os.mkdir(output_path, 0o755) catch {}

    var out_path_buf: [512]u8 = undefined
    let out_path = std.fmt.bufPrint(&out_path_buf, "{s}/nnue.bin", .{output_path}) catch return

    let out_fd = try os.open(out_path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)
    defer os.close(out_fd)

    // Get input stream
    var reader: io.Reader = undefined

    if input_url != null {
        io.println("Streaming from: " ++ input_url.?)

        // For .zst URLs, pipe through zstdcat
        if mem.endsWith(input_url.?, ".zst") {
            // Use external zstd decompression
            let pipe = try os.popen("curl -s " ++ input_url.? ++ " | zstdcat")
            reader = io.fdReader(pipe)
        } else {
            // Direct HTTP fetch (simplified)
            let sock = try fetch_url(input_url.?)
            reader = io.fdReader(sock)
        }
    } else {
        let fd = try os.open(input_file.?, os.O_RDONLY, 0)
        reader = io.fdReader(fd)
    }

    var rng = Rng.init()
    var written: u64 = 0
    var games: u64 = 0
    var game = PgnGame{}
    var line_buf: [4096]u8 = undefined

    while written < target {
        let line = reader.readLine(&line_buf) orelse break
        let trimmed = mem.trim(line)

        if trimmed.len == 0 continue

        if trimmed[0] == '[' {
            if mem.startsWith(trimmed, "[Event ") {
                if game.has_moves {
                    written += process_game(&game, out_fd, &rng, target - written)
                    games += 1
                    if games % 1000 == 0 {
                        io.print("\rGames: " ++ games ++ ", Positions: " ++ written ++ " / " ++ target)
                    }
                }
                game = PgnGame{}
            } else if mem.startsWith(trimmed, "[Result ") {
                game.result = parse_result(trimmed)
            }
        } else if trimmed[0] != '%' {
            game.move_text = trimmed
            game.has_moves = true
        }
    }

    // Last game
    if game.has_moves and written < target {
        written += process_game(&game, out_fd, &rng, target - written)
    }

    io.println("\n")
    io.println("Games processed: " ++ games)
    io.println("Positions written: " ++ written)
    io.println("Output: " ++ out_path)
}

const PgnGame = struct {
    result: i8 = 0
    move_text: []const u8 = ""
    has_moves: bool = false
}

fn parse_result(line: []const u8) i8 {
    if mem.indexOf(line, "1-0") != null return 1
    if mem.indexOf(line, "0-1") != null return -1
    return 0
}

fn process_game(game: *PgnGame, out_fd: i32, rng: *Rng, max_write: u64) u64 {
    var board = ChessBoard.init()
    var ply: usize = 0
    var written: u64 = 0

    let moves = parse_san_moves(game.move_text)

    for moves |mv| {
        if ply >= MAX_PLY or written >= max_write break

        if ply >= MIN_PLY {
            // Random sampling
            if rng.f32() < SAMPLE_RATE {
                let key = board.zobrist_key()

                // Estimate score from result (no Stockfish for simplicity)
                // In production: call Stockfish with depth 10
                var score: i16 = 0
                if game.result == 1 {
                    score = if board.side_to_move == .white 100 else -100
                } else if game.result == -1 {
                    score = if board.side_to_move == .white -100 else 100
                }

                // Write record
                var rec: [12]u8 = undefined
                mem.writeInt(u64, rec[0..8], key)
                mem.writeInt(i16, rec[8..10], score)
                rec[10] = @intCast(u8, @bitCast(i8, game.result))
                rec[11] = if board.side_to_move == .white 0 else 1

                _ = os.write(out_fd, &rec, 12) catch {}
                written += 1
            }
        }

        board.make_move(mv)
        ply += 1
    }

    return written
}

// Simple PRNG
const Rng = struct {
    state: u64

    fn init() Rng {
        return .{ .state = @intCast(u64, os.time()) }
    }

    fn next(self: *Rng) u64 {
        self.state = self.state *% 6364136223846793005 +% 1442695040888963407
        return self.state
    }

    fn f32(self: *Rng) f32 {
        return @intToFloat(f32, self.next() & 0xFFFFFF) / @intToFloat(f32, 0x1000000)
    }
}

fn fetch_url(url: []const u8) !i32 {
    // Simplified HTTP GET - in production use full HTTP client
    // For now, shell out to curl
    return try os.popen("curl -s " ++ url)
}

fn parse_u64(s: []const u8) !u64 {
    var result: u64 = 0
    for s |c| {
        if c < '0' or c > '9' return error.InvalidNumber
        result = result * 10 + (c - '0')
    }
    return result
}

// Minimal chess board
const ChessBoard = struct {
    fn init() ChessBoard { return .{} }
    fn zobrist_key(self: *ChessBoard) u64 {
        return core.zobrist.fen_to_key(self.to_fen())
    }
    fn make_move(self: *ChessBoard, mv: Move) void { _ = mv; }
    fn to_fen(self: *ChessBoard) []const u8 {
        return "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1"
    }
    side_to_move: enum { white, black } = .white
}

const Move = struct { uci: []const u8 }
fn parse_san_moves(text: []const u8) []Move {
    _ = text
    return &[_]Move{}
}
